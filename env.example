# ─── MTN Developer Portal Credentials ───────────────────────────────────────
# Get these from https://developers.mtn.com after registering your app
# and subscribing to the Customer KYC API.
#
# On the portal these are labelled:
#   "Production key"    → MTN_CONSUMER_KEY
#   "Production secret" → MTN_CONSUMER_SECRET
#
# The OAuth token URL is hardcoded in server.js as:
#   https://api.mtn.com/v1/oauth/access_token
# You do NOT need to set it here.

MTN_CONSUMER_KEY=your_consumer_key_here
MTN_CONSUMER_SECRET=your_consumer_secret_here

# Server port (default: 3000)
PORT=3000
