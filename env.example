# ============================================================
# DataFlow Backend — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to git — it's in .gitignore
# ============================================================

# ---- SERVER ----
PORT=3000
NODE_ENV=production

# ---- MTN OAUTH 2.0 (from developers.mtn.com → Your App → Production Keys) ----
MTN_CONSUMER_KEY=your_mtn_production_consumer_key_here
MTN_CONSUMER_SECRET=your_mtn_production_consumer_secret_here

# ---- REMADATA (data delivery provider) ----
REMADATA_BASE=https://api.remadata.net
REMADATA_TOKEN=your_remadata_api_token_here
REMADATA_SENDER=your_remadata_sender_id_here

# ---- PAYSTACK (for webhook verification) ----
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here

# ---- FIREBASE ADMIN (service account) ----
# Option A: paste the full JSON as a single-line string (recommended for Render)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}

# Option B: path to the downloaded service account JSON file (local dev only)
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

FIREBASE_DATABASE_URL=https://stafford-2efd9-default-rtdb.firebaseio.com
